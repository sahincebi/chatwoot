<% content_for(:title) do %>
  Support Tickets
<% end %>

<section class="main-content__body px-8">
  <div class="bg-white py-4 px-2">
    <h1 class="text-base font-medium leading-6 text-n-slate-12 mb-4">Support Tickets</h1>

    <% if @tickets.empty? %>
      <div class="text-sm text-n-slate-11">No support tickets found.</div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-n-slate-11 border-b border-n-weak">
              <th class="py-2 pr-4">ID</th>
              <th class="py-2 pr-4">Subject</th>
              <th class="py-2 pr-4">Status</th>
              <th class="py-2 pr-4">Updated</th>
              <th class="py-2 pr-4">Requester</th>
              <th class="py-2 pr-4">Account</th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |ticket| %>
              <tr class="border-b border-n-weak">
                <td class="py-2 pr-4">
                  <%= link_to ticket.id, super_admin_support_ticket_path(ticket), class: 'text-woot-500 hover:text-woot-700' %>
                </td>
                <td class="py-2 pr-4">
                  <%= link_to ticket.subject, super_admin_support_ticket_path(ticket), class: 'text-woot-500 hover:text-woot-700' %>
                </td>
                <td class="py-2 pr-4"><%= ticket.status %></td>
                <td class="py-2 pr-4"><%= l(ticket.last_activity_at, format: :short) %></td>
                <td class="py-2 pr-4"><%= ticket.requester&.email || '-' %></td>
                <td class="py-2 pr-4"><%= ticket.account&.name || '-' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
