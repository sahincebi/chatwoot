<% content_for(:title) do %>
  Destek Talepleri
<% end %>
<% status_labels = { 'open' => 'Acik', 'pending' => 'Beklemede', 'solved' => 'Cozuldu', 'closed' => 'Kapali' } %>

<section class="main-content__body px-8">
  <div class="bg-white dark:bg-slate-900 py-4 px-2">
    <h1 class="text-base font-medium leading-6 text-n-slate-12 mb-4">Destek Talepleri</h1>

    <% if @tickets.empty? %>
      <div class="text-sm text-n-slate-11">Destek talebi bulunamadi.</div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-n-slate-11 border-b border-n-weak">
              <th class="py-2 pr-4">ID</th>
              <th class="py-2 pr-4">Konu</th>
              <th class="py-2 pr-4">Durum</th>
              <th class="py-2 pr-4">Guncelleme</th>
              <th class="py-2 pr-4">Talep Sahibi</th>
              <th class="py-2 pr-4">Hesap</th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |ticket| %>
              <tr class="border-b border-n-weak">
                <td class="py-2 pr-4">
                  <%= link_to ticket.id, super_admin_support_ticket_path(ticket), class: 'text-woot-500 hover:text-woot-700' %>
                </td>
                <td class="py-2 pr-4">
                  <%= link_to ticket.subject, super_admin_support_ticket_path(ticket), class: 'text-woot-500 hover:text-woot-700' %>
                  <% if ticket.unread_for_admin? %>
                    <span class="ml-2 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                      <%= t('support_tickets.unread', default: 'Okunmadi') %>
                    </span>
                  <% end %>
                </td>
                <td class="py-2 pr-4"><%= status_labels[ticket.status] || ticket.status %></td>
                <td class="py-2 pr-4"><%= l(ticket.last_activity_at, format: :short) %></td>
                <td class="py-2 pr-4"><%= ticket.requester&.email || '-' %></td>
                <td class="py-2 pr-4"><%= ticket.account&.name || '-' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
