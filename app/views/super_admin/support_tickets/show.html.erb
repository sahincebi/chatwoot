<% content_for(:title) do %>
  Destek Talebi <%= @ticket.id %>
<% end %>
<% status_labels = { 'open' => 'Acik', 'pending' => 'Beklemede', 'solved' => 'Cozuldu', 'closed' => 'Kapali' } %>
<% priority_labels = { 'low' => 'Dusuk', 'normal' => 'Normal', 'high' => 'Yuksek', 'urgent' => 'Acil' } %>

<section class="main-content__body px-8">
  <div class="bg-white dark:bg-slate-900 py-4 px-2">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-base font-medium leading-6 text-n-slate-12">
        Talep #<%= @ticket.id %>
      </h1>
      <%= link_to 'Destek Listesine Don', super_admin_support_tickets_path, class: 'text-sm text-woot-500 hover:text-woot-700' %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-n-slate-12 mb-6">
      <div>
        <div class="text-n-slate-11">Konu</div>
        <div><%= @ticket.subject %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Durum</div>
        <div class="flex items-center gap-3">
          <span><%= status_labels[@ticket.status] || @ticket.status %></span>
          <%= form_with model: @ticket, url: super_admin_support_ticket_path(@ticket), method: :patch, local: true do |form| %>
            <%= form.select :status,
                            options_for_select(SupportTicket.statuses.keys.map { |key| [status_labels[key] || key, key] }, @ticket.status),
                            {},
                            class: 'rounded border border-n-weak p-1 text-xs' %>
            <%= form.submit 'Guncelle', class: 'ml-2 text-xs text-woot-500 hover:text-woot-700' %>
          <% end %>
        </div>
      </div>
      <div>
        <div class="text-n-slate-11">Kategori</div>
        <div><%= @ticket.category || '-' %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Oncelik</div>
        <div><%= priority_labels[@ticket.priority] || @ticket.priority %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Talep Sahibi</div>
        <div><%= @ticket.requester&.email || '-' %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Hesap</div>
        <div><%= @ticket.account&.name || '-' %></div>
      </div>
    </div>

    <div class="border-t border-n-weak pt-4">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Mesajlar</h2>
      <div class="space-y-4">
        <% @messages.each do |message| %>
          <div class="rounded border border-n-weak p-3">
            <div class="text-xs text-n-slate-11 mb-2">
              <%= message.sender_role == 'support' ? 'Destek Ekibi' : 'Kullanici' %> -
              <%= message.sender&.name || message.sender&.email || '-' %> -
              <%= l(message.created_at, format: :short) %>
            </div>
            <div class="text-sm text-n-slate-12"><%= simple_format(message.body) %></div>
            <% if message.files.attached? %>
              <div class="mt-2 text-xs text-n-slate-11">
                Ekler:
                <% message.files.each do |file| %>
                  <%= link_to file.filename.to_s, rails_blob_path(file, disposition: 'attachment') %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="border-t border-n-weak pt-4 mt-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Yanitla</h2>
      <%= form_with url: reply_super_admin_support_ticket_path(@ticket), method: :post, local: true do |form| %>
        <div class="mb-3">
          <%= form.text_area :body, name: 'message[body]', rows: 4, class: 'w-full rounded border border-n-weak p-2 text-sm' %>
        </div>
        <%= form.submit 'Yanit Gonder', class: 'inline-flex items-center justify-center h-9 px-3 rounded text-sm font-medium text-n-slate-12 bg-transparent outline outline-1 outline-n-container hover:bg-slate-50' %>
      <% end %>
    </div>
  </div>
</section>
