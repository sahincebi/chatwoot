<% content_for(:title) do %>
  AI Faturalandirma
<% end %>

<section class="main-content__body px-8">
  <div class="bg-white dark:bg-slate-900 py-4 px-2">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <h1 class="text-base font-medium leading-6 text-n-slate-12">AI Faturalandirma</h1>
      <%= form_with url: super_admin_ai_billings_path, method: :get, local: true, class: 'flex items-center gap-2' do |form| %>
        <label class="text-xs text-n-slate-11">KPI donemi (gun)</label>
        <%= form.number_field :days, value: @days, min: 7, max: 365, class: 'w-24 rounded border border-n-weak p-2 text-sm' %>
        <%= form.submit 'Uygula', class: 'inline-flex items-center justify-center h-9 px-3 rounded text-sm font-medium text-n-slate-12 bg-transparent outline outline-1 outline-n-container hover:bg-slate-50' %>
      <% end %>
    </div>

    <div class="rounded border border-n-weak p-4 mb-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Global Fiyatlandirma Ayari</h2>
      <p class="text-xs text-n-slate-11 mb-3">
        Provider maliyeti: (input_tokens * input_rate + output_tokens * output_rate) / 1M.
        Kullaniciya yansiyan tutar: provider maliyeti * billing multiplier.
      </p>
      <%= form_with url: update_pricing_super_admin_ai_billings_path, method: :post, local: true do |form| %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <label class="text-xs text-n-slate-11">1M Input Token Maliyeti (USD)</label>
            <%= form.number_field :input_cost_per_1m, step: 0.0001, min: 0, required: true,
                                  value: @pricing_config.input_cost_per_1m,
                                  class: 'w-full rounded border border-n-weak p-2 text-sm' %>
          </div>
          <div>
            <label class="text-xs text-n-slate-11">1M Output Token Maliyeti (USD)</label>
            <%= form.number_field :output_cost_per_1m, step: 0.0001, min: 0, required: true,
                                  value: @pricing_config.output_cost_per_1m,
                                  class: 'w-full rounded border border-n-weak p-2 text-sm' %>
          </div>
          <div>
            <label class="text-xs text-n-slate-11">Faturalandirma Carpani</label>
            <%= form.number_field :billing_multiplier, step: 0.01, min: 0.01, required: true,
                                  value: @pricing_config.billing_multiplier,
                                  class: 'w-full rounded border border-n-weak p-2 text-sm' %>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-3">
          <%= form.submit 'Fiyatlandirmayi Guncelle',
                          class: 'inline-flex items-center justify-center h-9 px-3 rounded text-sm font-medium text-n-slate-12 bg-transparent outline outline-1 outline-n-container hover:bg-slate-50' %>
          <span class="text-xs text-n-slate-11">
            Kaynak: input=<%= @pricing_config.source[:input_cost_per_1m] %>,
            output=<%= @pricing_config.source[:output_cost_per_1m] %>,
            multiplier=<%= @pricing_config.source[:billing_multiplier] %>
          </span>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Toplam Bakiye</div>
        <div class="text-lg font-semibold text-n-slate-12">
          <%= number_to_currency(@wallets_by_account_id.values.sum(&:balance_cents).to_i / 100.0, unit: '$') %>
        </div>
      </div>
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Toplam Faturalanan</div>
        <div class="text-lg font-semibold text-n-slate-12">
          <%= number_to_currency(@global_totals[:billed_cost_cents] / 100.0, unit: '$') %>
        </div>
      </div>
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Toplam Provider Maliyeti</div>
        <div class="text-lg font-semibold text-n-slate-12">
          <%= number_to_currency(@global_totals[:provider_cost_cents] / 100.0, unit: '$') %>
        </div>
      </div>
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Tahmini Kar</div>
        <% profit = @global_totals[:profit_cents] %>
        <div class="text-lg font-semibold <%= profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= number_to_currency(profit / 100.0, unit: '$') %>
        </div>
      </div>
    </div>

    <div class="rounded border border-n-weak p-4 mb-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">KPI Ozeti (son <%= @days %> gun)</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Toplam Islem (AI Cevap)</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_with_delimiter(@kpi_totals[:request_count]) %></div>
        </div>
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Ortalama Islem Basina Faturalanan</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_to_currency(@kpi_totals[:avg_cents_per_request] / 100.0, unit: '$') %></div>
        </div>
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Ortalama 1K Token Maliyeti</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_to_currency(@kpi_totals[:avg_cents_per_1k_tokens] / 100.0, unit: '$') %></div>
        </div>
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Toplam Token</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_with_delimiter(@kpi_totals[:total_tokens]) %></div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="text-left text-n-slate-11 border-b border-n-weak">
                <th class="py-2 pr-4">Gun</th>
                <th class="py-2 pr-4">Islem</th>
                <th class="py-2 pr-4">Token</th>
                <th class="py-2 pr-4">Faturalanan</th>
                <th class="py-2 pr-4">Kar</th>
              </tr>
            </thead>
            <tbody>
              <% @kpi_daily.each do |row| %>
                <tr class="border-b border-n-weak">
                  <td class="py-2 pr-4"><%= row[:day] %></td>
                  <td class="py-2 pr-4"><%= number_with_delimiter(row[:request_count]) %></td>
                  <td class="py-2 pr-4"><%= number_with_delimiter(row[:total_tokens]) %></td>
                  <td class="py-2 pr-4"><%= number_to_currency(row[:billed_cost_cents] / 100.0, unit: '$') %></td>
                  <td class="py-2 pr-4 <%= row[:profit_cents] >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    <%= number_to_currency(row[:profit_cents] / 100.0, unit: '$') %>
                  </td>
                </tr>
              <% end %>
              <% if @kpi_daily.empty? %>
                <tr>
                  <td colspan="5" class="py-3 text-n-slate-11">Secilen donemde KPI verisi yok.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="text-left text-n-slate-11 border-b border-n-weak">
                <th class="py-2 pr-4">Hesap</th>
                <th class="py-2 pr-4">Islem</th>
                <th class="py-2 pr-4">Token</th>
                <th class="py-2 pr-4">Faturalanan</th>
                <th class="py-2 pr-4">Kar</th>
              </tr>
            </thead>
            <tbody>
              <% @kpi_top_accounts.each do |row| %>
                <tr class="border-b border-n-weak">
                  <td class="py-2 pr-4"><%= row[:account_name] %> (#<%= row[:account_id] %>)</td>
                  <td class="py-2 pr-4"><%= number_with_delimiter(row[:request_count]) %></td>
                  <td class="py-2 pr-4"><%= number_with_delimiter(row[:total_tokens]) %></td>
                  <td class="py-2 pr-4"><%= number_to_currency(row[:billed_cost_cents] / 100.0, unit: '$') %></td>
                  <td class="py-2 pr-4 <%= row[:profit_cents] >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    <%= number_to_currency(row[:profit_cents] / 100.0, unit: '$') %>
                  </td>
                </tr>
              <% end %>
              <% if @kpi_top_accounts.empty? %>
                <tr>
                  <td colspan="5" class="py-3 text-n-slate-11">Secilen donemde hesap bazli KPI verisi yok.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% if @accounts.empty? %>
      <div class="text-sm text-n-slate-11">Hesap bulunamadi.</div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-n-slate-11 border-b border-n-weak">
              <th class="py-2 pr-4">Hesap</th>
              <th class="py-2 pr-4">Bakiye</th>
              <th class="py-2 pr-4">Topup Toplam</th>
              <th class="py-2 pr-4">Faturalanan</th>
              <th class="py-2 pr-4">Provider Maliyet</th>
              <th class="py-2 pr-4">Kar</th>
              <th class="py-2 pr-4">Token</th>
              <th class="py-2 pr-4">Detay</th>
            </tr>
          </thead>
          <tbody>
            <% @accounts.each do |account| %>
              <% wallet = @wallets_by_account_id[account.id] %>
              <% totals = @usage_totals_by_account_id[account.id] || { billed_cost_cents: 0, provider_cost_cents: 0, profit_cents: 0, total_tokens: 0 } %>
              <% topup_total = @topup_totals_by_account_id[account.id].to_i %>
              <tr class="border-b border-n-weak">
                <td class="py-2 pr-4">
                  <div class="font-medium text-n-slate-12"><%= account.name %></div>
                  <div class="text-xs text-n-slate-11">#<%= account.id %></div>
                </td>
                <td class="py-2 pr-4"><%= number_to_currency(wallet&.balance_cents.to_i / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4"><%= number_to_currency(topup_total / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4"><%= number_to_currency(totals[:billed_cost_cents] / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4"><%= number_to_currency(totals[:provider_cost_cents] / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4 <%= totals[:profit_cents] >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= number_to_currency(totals[:profit_cents] / 100.0, unit: '$') %>
                </td>
                <td class="py-2 pr-4"><%= number_with_delimiter(totals[:total_tokens]) %></td>
                <td class="py-2 pr-4">
                  <%= link_to 'Ac', super_admin_ai_billing_path(account), class: 'text-woot-500 hover:text-woot-700' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
