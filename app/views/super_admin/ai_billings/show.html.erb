<% content_for(:title) do %>
  AI Faturalandirma - <%= @account.name %>
<% end %>

<section class="main-content__body px-8">
  <div class="bg-white dark:bg-slate-900 py-4 px-2">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-base font-medium leading-6 text-n-slate-12">
        AI Faturalandirma: <%= @account.name %> (#<%= @account.id %>)
      </h1>
      <div class="flex items-center gap-3">
        <%= form_with url: super_admin_ai_billing_path(@account), method: :get, local: true, class: 'flex items-center gap-2' do |form| %>
          <label class="text-xs text-n-slate-11">KPI donemi (gun)</label>
          <%= form.number_field :days, value: @days, min: 7, max: 365, class: 'w-24 rounded border border-n-weak p-2 text-sm' %>
          <%= form.submit 'Uygula', class: 'inline-flex items-center justify-center h-9 px-3 rounded text-sm font-medium text-n-slate-12 bg-transparent outline outline-1 outline-n-container hover:bg-slate-50' %>
        <% end %>
        <%= link_to 'Billing Listesine Don', super_admin_ai_billings_path, class: 'text-sm text-woot-500 hover:text-woot-700' %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Bakiye</div>
        <div class="text-lg font-semibold text-n-slate-12">
          <%= number_to_currency(@wallet.balance_cents / 100.0, unit: '$') %>
        </div>
      </div>
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Faturalanan</div>
        <div class="text-lg font-semibold text-n-slate-12">
          <%= number_to_currency(@usage_totals[:billed_cost_cents] / 100.0, unit: '$') %>
        </div>
      </div>
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Provider Maliyet</div>
        <div class="text-lg font-semibold text-n-slate-12">
          <%= number_to_currency(@usage_totals[:provider_cost_cents] / 100.0, unit: '$') %>
        </div>
      </div>
      <div class="rounded border border-n-weak p-3">
        <div class="text-xs text-n-slate-11">Kar</div>
        <% profit = @usage_totals[:profit_cents] %>
        <div class="text-lg font-semibold <%= profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= number_to_currency(profit / 100.0, unit: '$') %>
        </div>
      </div>
    </div>

    <div class="rounded border border-n-weak p-4 mb-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">KPI Ozeti (son <%= @days %> gun)</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Toplam Islem</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_with_delimiter(@kpi_totals[:request_count]) %></div>
        </div>
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Toplam Token</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_with_delimiter(@kpi_totals[:total_tokens]) %></div>
        </div>
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Ortalama Islem Basina Faturalanan</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_to_currency(@kpi_totals[:avg_cents_per_request] / 100.0, unit: '$') %></div>
        </div>
        <div class="rounded border border-n-weak p-3">
          <div class="text-xs text-n-slate-11">Ortalama 1K Token Maliyeti</div>
          <div class="text-lg font-semibold text-n-slate-12"><%= number_to_currency(@kpi_totals[:avg_cents_per_1k_tokens] / 100.0, unit: '$') %></div>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-n-slate-11 border-b border-n-weak">
              <th class="py-2 pr-4">Gun</th>
              <th class="py-2 pr-4">Islem</th>
              <th class="py-2 pr-4">Token</th>
              <th class="py-2 pr-4">Faturalanan</th>
              <th class="py-2 pr-4">Kar</th>
            </tr>
          </thead>
          <tbody>
            <% @kpi_daily.each do |row| %>
              <tr class="border-b border-n-weak">
                <td class="py-2 pr-4"><%= row[:day] %></td>
                <td class="py-2 pr-4"><%= number_with_delimiter(row[:request_count]) %></td>
                <td class="py-2 pr-4"><%= number_with_delimiter(row[:total_tokens]) %></td>
                <td class="py-2 pr-4"><%= number_to_currency(row[:billed_cost_cents] / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4 <%= row[:profit_cents] >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= number_to_currency(row[:profit_cents] / 100.0, unit: '$') %>
                </td>
              </tr>
            <% end %>
            <% if @kpi_daily.empty? %>
              <tr>
                <td colspan="5" class="py-3 text-n-slate-11">Secilen donemde KPI verisi yok.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded border border-n-weak p-4 mb-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Bakiye Yukle (Manuel Topup)</h2>
      <%= form_with url: topup_super_admin_ai_billing_path(@account), method: :post, local: true do |form| %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <label class="text-xs text-n-slate-11">Tutar (cent)</label>
            <%= form.number_field :amount_cents, min: 1, step: 1, required: true, class: 'w-full rounded border border-n-weak p-2 text-sm' %>
          </div>
          <div>
            <label class="text-xs text-n-slate-11">Saglayici Referansi (opsiyonel)</label>
            <%= form.text_field :provider_ref, class: 'w-full rounded border border-n-weak p-2 text-sm' %>
          </div>
          <div>
            <label class="text-xs text-n-slate-11">Not (opsiyonel)</label>
            <%= form.text_field :note, class: 'w-full rounded border border-n-weak p-2 text-sm' %>
          </div>
        </div>
        <div class="mt-3">
          <%= form.submit 'Topup Uygula', class: 'inline-flex items-center justify-center h-9 px-3 rounded text-sm font-medium text-n-slate-12 bg-transparent outline outline-1 outline-n-container hover:bg-slate-50' %>
        </div>
      <% end %>
    </div>

    <div class="rounded border border-n-weak p-4 mb-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Fatura Gecmisi (Islemler)</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-n-slate-11 border-b border-n-weak">
              <th class="py-2 pr-4">Tarih</th>
              <th class="py-2 pr-4">Tur</th>
              <th class="py-2 pr-4">Tutar</th>
              <th class="py-2 pr-4">Saglayici</th>
              <th class="py-2 pr-4">Ref</th>
              <th class="py-2 pr-4">Not</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_transactions.each do |transaction| %>
              <tr class="border-b border-n-weak">
                <td class="py-2 pr-4"><%= l(transaction.created_at, format: :short) %></td>
                <td class="py-2 pr-4"><%= transaction.kind %></td>
                <td class="py-2 pr-4"><%= number_to_currency(transaction.amount_cents / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4"><%= transaction.provider || '-' %></td>
                <td class="py-2 pr-4"><%= transaction.provider_ref || '-' %></td>
                <td class="py-2 pr-4"><%= transaction.meta&.[]('note') || '-' %></td>
              </tr>
            <% end %>
            <% if @recent_transactions.empty? %>
              <tr>
                <td colspan="6" class="py-3 text-n-slate-11">Henuz transaction yok.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded border border-n-weak p-4">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">AI Kullanim Gecmisi</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-n-slate-11 border-b border-n-weak">
              <th class="py-2 pr-4">Tarih</th>
              <th class="py-2 pr-4">Gorusme</th>
              <th class="py-2 pr-4">Mesaj</th>
              <th class="py-2 pr-4">Model</th>
              <th class="py-2 pr-4">Tokens</th>
              <th class="py-2 pr-4">Saglayici Maliyet</th>
              <th class="py-2 pr-4">Faturalanan</th>
              <th class="py-2 pr-4">Kar</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_usage_logs.each do |usage| %>
              <% provider_cost = usage.provider_cost_cents.to_i %>
              <% billed_cost = usage.billed_cost_cents.to_i.nonzero? || usage.cost_cents.to_i %>
              <% profit = billed_cost - provider_cost %>
              <tr class="border-b border-n-weak">
                <td class="py-2 pr-4"><%= l(usage.created_at, format: :short) %></td>
                <td class="py-2 pr-4"><%= usage.conversation_id || '-' %></td>
                <td class="py-2 pr-4"><%= usage.message_id || '-' %></td>
                <td class="py-2 pr-4"><%= usage.model || '-' %></td>
                <td class="py-2 pr-4"><%= number_with_delimiter(usage.total_tokens.to_i) %></td>
                <td class="py-2 pr-4"><%= number_to_currency(provider_cost / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4"><%= number_to_currency(billed_cost / 100.0, unit: '$') %></td>
                <td class="py-2 pr-4 <%= profit >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= number_to_currency(profit / 100.0, unit: '$') %>
                </td>
              </tr>
            <% end %>
            <% if @recent_usage_logs.empty? %>
              <tr>
                <td colspan="8" class="py-3 text-n-slate-11">Henuz usage kaydi yok.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
