<% content_for(:title) do %>
  Support Ticket <%= @conversation.id %>
<% end %>

<% attrs = @conversation.additional_attributes || {} %>

<section class="main-content__body px-8">
  <div class="bg-white py-4 px-2">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-base font-medium leading-6 text-n-slate-12">
        Ticket #<%= @conversation.id %>
      </h1>
      <%= link_to 'Back to Support', super_admin_support_path, class: 'text-sm text-woot-500 hover:text-woot-700' %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-n-slate-12 mb-6">
      <div>
        <div class="text-n-slate-11">Subject</div>
        <div><%= attrs['support_subject'] || '-' %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Status</div>
        <div><%= @conversation.status %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Category</div>
        <div><%= attrs['support_category'] || '-' %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Priority</div>
        <div><%= attrs['support_priority'] || '-' %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Requester</div>
        <div><%= attrs['support_requested_by_user_email'] || @conversation.contact&.email || '-' %></div>
      </div>
      <div>
        <div class="text-n-slate-11">Account</div>
        <div><%= attrs['support_requested_by_account_name'] || '-' %></div>
      </div>
    </div>

    <div class="border-t border-n-weak pt-4">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Messages</h2>
      <div class="space-y-4">
        <% @messages.each do |message| %>
          <div class="rounded border border-n-weak p-3">
            <div class="text-xs text-n-slate-11 mb-2">
              <%= message.message_type %> •
              <%= message.sender&.name || message.sender&.email || 'Contact' %> •
              <%= l(message.created_at, format: :short) %>
            </div>
            <div class="text-sm text-n-slate-12"><%= simple_format(message.content) %></div>
            <% if message.attachments.any? %>
              <div class="mt-2 text-xs text-n-slate-11">
                Attachments:
                <% message.attachments.each do |attachment| %>
                  <%= link_to attachment.file.filename.to_s, rails_blob_path(attachment.file, disposition: 'attachment') %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="border-t border-n-weak pt-4 mt-6">
      <h2 class="text-sm font-medium text-n-slate-12 mb-3">Reply</h2>
      <%= form_with url: super_admin_support_ticket_reply_path(@conversation), method: :post, local: true do |form| %>
        <div class="mb-3">
          <%= form.text_area :content, rows: 4, class: 'w-full rounded border border-n-weak p-2 text-sm' %>
        </div>
        <%= form.submit 'Send Reply', class: 'inline-flex items-center justify-center h-9 px-3 rounded text-sm font-medium text-n-slate-12 bg-transparent outline outline-1 outline-n-container hover:bg-slate-50' %>
      <% end %>
    </div>
  </div>
</section>
