<li class="px-4 mb-1">
  <% text_class_name = current_page?(url) ? 'text-woot-500 bg-slate-25 dark:bg-slate-800' : 'text-slate-800 dark:text-slate-200' %>
  <%= link_to(url, class: text_class_name + " -ml-1 focus:outline-none cursor-pointer flex items-center px-2 py-1.5 hover:text-woot-500 hover:bg-slate-25 dark:hover:bg-slate-800 rounded-lg transition") do %>
    <svg width="16" height="16"><use xlink:href="#<%= icon %>" /></svg>
    <span class="ml-2 text-sm"><%= label %></span>
  <% end %>
</li>
